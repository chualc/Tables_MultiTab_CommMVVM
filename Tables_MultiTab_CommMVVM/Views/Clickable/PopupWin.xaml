<Window x:Class="Tables_MultiTab_CommMVVM.Views.Clickable.PopupWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cell Details"
        Width="360"
        Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
                WindowStyle="ToolWindow"
        Background="#F4F6F9">

    <Border Margin="16"
            Padding="20"
            Background="White"
            CornerRadius="8"
            BorderBrush="#D8DEE8"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="Cell Details"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ColumnName,
                              StringFormat=Column: {0}}"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{Binding CellValue,
                              StringFormat=Value: {0}}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{Binding RowId,
                              StringFormat=Row ID: {0}}"
                       FontSize="14"
                       Margin="0,0,0,16"/>

            <Button Content="Close"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Right"
                    Background="#1976D2"
                    Foreground="White"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</Window>
    