<Window x:Class="Tables_MultiTab_CommMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tables_MultiTab_CommMVVM.Views"
        Title="Management System"
        Height="500"
        Width="900"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <!-- Common tab style -->
        <Style x:Key="ColoredTabStyle"
               TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="1"/>
                                <Setter Property="FontSize"
                                        Value="15"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="False">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <TabControl Background="White"
                    BorderThickness="0"
                    Padding="8"
                    TabStripPlacement="Top"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- Tab 1: Blue -->
            <TabItem Header="Table 1"
                     Style="{StaticResource ColoredTabStyle}"
                     Background="#1976D2">
                <views:Table1View
                    DataContext="{Binding Table1}"/>
            </TabItem>

            <!-- Tab 2: Green -->
            <TabItem Header="Table 2"
                     Style="{StaticResource ColoredTabStyle}"
                     Background="#388E3C">
                <views:Table2View
                    DataContext="{Binding Table2}"/>
            </TabItem>


            <!-- Tab 3: Orange -->
            <TabItem Header="Table 3"
                     Style="{StaticResource ColoredTabStyle}"
                     Background="#EF6C00">
                <views:Table3View
                    DataContext="{Binding Table3}"/>
            </TabItem>

            <!-- TODO: Step 6: Add a new tab. -->
            <!-- Tab 4: Pink -->
            <TabItem Header="Table 4"
                     Style="{StaticResource ColoredTabStyle}"
                     Background="Pink">
                <views:Table4View
                    DataContext="{Binding Table4}"/>
            </TabItem>

        </TabControl>
    </Grid>
</Window>

